# ============================================================
# Polymarket 事件驱动候选单系统 - 环境变量配置
# ============================================================

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/polymarket_agent
DATABASE_URL_SYNC=postgresql://postgres:***@localhost:5432/polymarket_agent

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- 6551 OpenNews 事件源 ----------
# Token 从 https://6551.io/mcp 获取
OPENNEWS_TOKEN=your_opennews_token_here
OPENNEWS_BASE_URL=https://ai.6551.io
OPENNEWS_WS_URL=

# ---------- Polymarket 凭证 (CLOB API) ----------
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_KEY_ID=
POLYMARKET_PASSPHRASE=

# ---------- 应用级配置 ----------
APP_ENV=development
DRY_RUN=true
LOG_LEVEL=INFO

# ---------- Hermes Orchestration ----------
HERMES_ENDPOINT=http://127.0.0.1:8642
HERMES_API_KEY=
