# ============================================================
# Polymarket 事件驱动候选单系统 - 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================================

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/polymarket_agent
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/polymarket_agent

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- 6551 OpenNews 事件源 ----------
OPENNEWS_TOKEN=
OPENNEWS_BASE_URL=https://api.opennews.6551.io/v1
OPENNEWS_WS_URL=wss://ws.opennews.6551.io/v1/stream

# ---------- Polymarket 凭证 ----------
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# ---------- 应用级配置 ----------
APP_ENV=development
# DRY_RUN=true 为默认值，仅模拟执行，不发送真实订单
DRY_RUN=true
LOG_LEVEL=INFO

# ---------- Hermes Orchestration ----------
HERMES_ENDPOINT=
HERMES_API_KEY=
